            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <p>
                    <milestone n="A" type="pagelike" unit="zone"/>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </p>
                <p>
                    kō-
                    <lb n="2" break="no"/>-p-para-kēcari-pa<hi rend="grantha">nma</hi>r-ā
                    <lb n="3" break="no"/><choice><orig><unclear>n</unclear></orig><reg>ṉ</reg></choice><unclear>a</unclear> <hi rend="grantha">śrī</hi>-rā<hi rend="grantha">jen<choice><orig>t</orig><reg>d</reg></choice>ra</hi>-cōḻa
                    <lb n="4"/><hi rend="grantha">de</hi>vark=ku yāṇṭu 3 Āva
                    <lb n="5" break="no"/>tu 
                </p>
                <p>
                    Uyyakkoṇṭār-vaḷan
                    <lb n="6" break="no"/>āṭṭu-t tiraim<choice><sic>u</sic><corr>ū</corr></choice>r-nāṭṭu <hi rend="grantha">śrī</hi>-tiru-vāva
                    <lb n="7" break="no"/>ṭu-tuṟai Uṭaiyār civa-<hi rend="grantha">brāhma</hi>ṇa
                    <lb n="8" break="no"/>r mōci-tuṟaiyāṉ kaṭa<supplied reason="omitted">va</supplied><choice><orig>n</orig><reg>ṉ</reg></choice>um
                    <lb n="9"/>tuṟaiyāṉ <unclear>Eṟṟi</unclear>yūra<choice><orig>n</orig><reg>ṉ</reg></choice>um
                    <lb n="10"/>tuṟaiyā<choice><orig>n</orig><reg>ṉ</reg></choice> tirumāliruñc<unclear>o<!--kompu clear--></unclear>                    
                    <lb n="11" break="no"/>laiyum mōci Āyirava<choice><orig>n</orig><reg>ṉ</reg></choice> n<supplied reason="lost">ā</supplied>r<choice><sic>a</sic><corr>ā</corr></choice>
                    <lb n="12" break="no"/>yaṇa<choice><orig>n</orig><reg>ṉ</reg></choice>um Āyirava<choice><orig>n</orig><reg>ṉ</reg></choice> paṇṭa<choice><orig>n</orig><reg>ṉ</reg></choice>u
                    <lb n="13" break="no"/>m Ivvaṉaivōm kai-yy-e
                    <lb n="14" break="no"/>ḻuttu
                </p>
                <p>
                    In-nāṭṭu veṇṇāṭṭu <hi rend="grantha">bra</hi>
                    <lb n="15" break="no"/><hi rend="grantha">hmade</hi>yam tiruviḻimiḻalai
                    <lb n="16"/>Āritaṉ nilan vaṭuka<choice><orig>n</orig><reg>ṉ</reg></choice> kai-y
                    <lb n="17"/><surplus>yāṅkaḷ</surplus> <space/> k<unclear>o<!--kāl clear--></unclear>ṇṭu kaṭaviya mu 
                    <lb n="18" break="no"/>tal nellu <num value="45">4 <g type="numeral">10</g> 5</num> <g ref="sym:tam-kalam" type="symbol">@</g>
                </p>
                <p>                    
                    In-nellu n<supplied reason="lost">ā</supplied>
                    <lb n="19" break="no"/>l-patt’ aiṅ-kalamum Ivv-āṭṭai Appi
                    <lb n="20" break="no"/>kai-t tiṅkaḷ mutal koṇṭu kaṭavōm ⌈
                    <lb n="21" break="no"/>koṇṭa paric’ āvatu
                </p>
                <p>
                    In-nelluk=ku kalattu
                    <lb n="22" break="no"/>vāy mu-k-kuṟuṇi-p palicaiyāl Orāṭ⌈
                    <lb n="23" break="no"/>ṭai n<unclear>ā</unclear>ḷaik=ku-p palicaiyā<supplied reason="omitted">l</supplied> van=ta nel
                    <lb n="24" break="no"/>lu <num value="11"><g type="numeral">10</g> 1</num> <g ref="sym:tam-kalam" type="symbol">@</g> <g ref="sym:tam-mukkuruni" type="symbol">@</g>
                </p>
                
                <p>
                    Ip-patiṉ oru kala<choice><orig>n</orig><reg>ṉ</reg></choice>ē
                    <lb n="25" break="no"/>muk=kuṟuṇik=ku nit=ti nivan=tam c<choice><orig>e</orig><reg>ey</reg></choice>ta paric’ āva
                    <lb n="26" break="no"/>tu
                </p>
                
                <p>
                    Ip-palicai-y-ā<choice><orig>n</orig><reg>ṉ</reg></choice>a nel<unclear>lu</unclear>k=ku Aṟu
                    <lb n="27"/>kuṟuṇi koḷḷik=kuṭattāl kāviri niṉṟum pō
                    <lb n="28" break="no"/>tu Oru kuṭan= tiru-mañc<choice><sic>u</sic><corr>a</corr></choice>ṇa-n<choice><orig>i</orig><reg>ī</reg></choice>r āka muṉṟu pō
                    <lb n="29" break="no"/>taik=ku muk=kuṭan= tiru-mañc<choice><sic>u</sic><corr>a</corr></choice>ṇa-n<choice><orig>i</orig><reg>ī</reg></choice>rē nā
                    <lb n="30" break="no"/>ḷ paṭi ca<hi rend="grantha">n<choice><orig>t</orig><reg>d</reg></choice>rā</hi>tittavaṟ Aṭṭuvat’ āka
                    <lb n="31" break="no"/>vum
                </p>
                
                <p>
                    Ip-palicai cekuttu ca<hi rend="grantha">n<choice><orig>t</orig><reg>d</reg></choice>rā</hi>di
                    
                    <milestone n="B" type="pagelike" unit="zone"/>
                    <lb n="32" break="no"/>ttavaṟ I-<hi rend="grantha">śrī</hi>-kōyi
                    <lb n="33" break="no"/>l-uṭaiyārkaḷ Uḷḷa
                    <lb n="34" break="no"/>vum It-tirumañc<choice><sic>u</sic><corr>a</corr></choice>
                    <lb n="35" break="no"/>ṇa-n<choice><orig>i</orig><reg>ī</reg></choice>rē Aṭṭuva
                    <lb n="36" break="no"/>t’ āṉōm civa-<hi rend="grantha">brā</hi>
                    <lb n="37" break="no"/><hi rend="grantha">hma</hi>ṇar Ivva⌈
                    <lb n="38" break="no"/>naivōm
                </p>
                <p>
                    Itu pa
                    <lb n="39" break="no"/><hi rend="grantha">nmāheśva</hi>ra-<hi rend="grantha">ra⌈</hi>                    
                    <lb n="40" break="no"/><hi rend="grantha">kṣai</hi>                    
                    
                </p>
                
                
