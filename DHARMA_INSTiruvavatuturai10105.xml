            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <ab>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>
                
                <lg n="1" met="āciriyappā">
                    <l n="1">tiru-makaḷ pōla-p peru-nila-c-celviyun</l>
                    <l n="2">ta<supplied reason="lost">ṉakkē y-urimai pūṇṭamai maṉa-k-koḷa-k</supplied></l>
                    <l n="3">kāntaḷūr-c cālai kalam a<supplied reason="lost">ṟu</supplied>tt’ aruḷi</l>
                    <l n="4">vēṅkai-nāṭum kaṅka-pāṭiyu<supplied reason="subaudible">m</supplied></l>
                    <l n="5">nuḷampa-pāṭiyum taṭikai vaḻiyuṅ</l>
                    <l n="6"><supplied reason="lost">kuṭamalai nāṭuṅ</supplied> kollamuṅ kaliṅkamuṅ</l>
                    <l n="7">tiṇ ṭiṟal veṉṟi taṇṭāṟ koṇṭu ta<choice><orig>ṉṉ</orig><reg>ṉ</reg></choice></l>
                    <l n="8">eḻil vaḷar Ūḻ<supplied reason="lost">iyuḷ y-e</supplied>llā yāṇṭum</l>
                    <l n="9">toḻutaka viḷaṅkum yāṇṭē</l>
                    <l n="10">ceḻi<lb n="2" break="no"/>yarai-t tēcu koḷ</l>
                </lg>
                
                <p>
                    kō-v-irā<hi rend="grantha">ja</hi>-rā<hi rend="grantha">ja</hi>-rā<hi rend="grantha">ja</hi>-kēcari-<hi rend="grantha">panma</hi>ṟku yāṇṭu <num value="16"><g type="numeral">10</g> 6</num>-Āvatu
                </p>
                
                <p>
                    teṉ-karai-t tiruvaḻuntūr-nāṭṭu <hi rend="grantha">brahmade</hi>yam ciṟṟāṉaiccūr sabhaiyōṅ kai-<choice><orig>yy</orig><reg>y</reg></choice>-eḻuttu
                </p>
                
                <p>                    
                    tiraimūr-nāṭṭu-p <hi rend="grantha">brahmade</hi>yaṅ cātta<choice><orig>n</orig><reg>ṉ</reg></choice>ūr tiruvāṭutuṟai <hi rend="grantha">mahāde</hi>vark=ku <hi rend="grantha">mūlabhṛtya</hi>ṉ-āṉa <hi rend="grantha">caṇḍeśv<choice><sic>ā</sic><corr>a</corr></choice></hi>ra-kaiyyāl <unclear reason="eccentric_ductus">nā</unclear>ṅkaḷ koṇṭu kaṭaviya poṉ kaḻaiñciṟ pēr{t]ttu kācuk=ku mu‡k=kālē muṉṟu mañcāṭi-y-āka koṇṭa poṉ <num value="27">2 <g type="numeral">10</g> 7</num> m <gap reason="illegible" quantity="3" unit="character"/><!--3 fractions-->
                    <lb n="3"/>koṇṭu kaṭavōm Ip-poṉ koṇṭa paric-āvatu
                </p>
                <p>
                    ...
                    <lb n="4"/>...
                    <lb n="5"/>...
                    <lb n="6"/>...
                </p>
                
