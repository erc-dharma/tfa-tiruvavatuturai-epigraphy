        <body>
            
            <div type="edition" xml:lang="tam-Latn" n="1" rendition="class:tamil maturity:83215">		
                
                
                <pb n="1r"/>
                <p>
                    <lb n="1r1=1"/><hi rend="bold">svasti śrī vijayābhyudaya śālivākana śaka varṣaṁ</hi> <num value="1612"> <num>1000</num> 6 <num>100</num>
                    <lb n="1r2=2"/><num>10</num> 2</num>k=ku mēl cellā niṉṟa <!-- until here -->vikrama ila āvaṇi mī 5 pūrva paṭcattut ti
                    <lb n="1r3=3"/>ritiyai cōmavāram uttiraṭṭāti nakṣattiram civanāmayō
                    <lb n="1r4=4"/>kam pālavākaraṇam itukaḷ kūṭiṉa cupatiṉattil 
                </p>
                <p>
                    śrīmar rā
                    <lb n="1r5=5"/>jāti rāja rāja paramēsvara rāja mārttāṇṭa śrī rāmatē
                    <lb n="1r6=6"/>varāyarkku cimmāca nārūṭarāka pirutvi cāmrā
                    <lb n="1r7=7"/>jyam paṇṇā nikkiṟa kālattil 
                </p>
                <p>
                    uyya koṇṭa śrī cōḻa
                    <lb n="1r8=8"/>vaḷa nāṭṭil pirammatēcam kōṭṭaikkarai matiḷukkuk kiḻa
                    <lb n="1r9=9"/>kku tirumacciyūr cāvaṭikku mēṟku kāvēriyāttukku e
                    <lb n="1r10=10"/>taṟku tiruvārūr cāvaṭikku vaṭakku rājakampīra vaḷāra
                    <lb n="1r11=11"/>ṭṭil hari natikku vaṭakaraiyil tivya civa cēttiramāṉa tiru
                    <lb n="1r12=12"/>vīḻimiḻalaiyil śrītēci nivantēsvara cuvāmikku 
                   <list><item>mallūr
                    <lb n="1r13=13"/>pattu kīḻmukam mēl mukam acēṣa vitva makājaṉaṅkaḷum</item> 
                    <item>cam
                    <lb n="1r14=14"/>pacam kirāmattil makājaṉaṅkaḷum</item> 
                    <item>taraku nalluva kēca
                    <lb n="1r15=15"/>ri aviḻēka maṅkalattil makājaṉaṅkaḷum</item>
                    <item>koṟaiṉā
                    <lb n="1r16=16"/>ṭṭuc cīmai cēṅkaṇapi nallūr vaḷākam mākāṇa
                    <lb n="1r17=17"/>ttil kuṭiyāṉa pērkaḷum</item> 
                    <item>vaṭamuṭṭam kuṭiyāṉa
                    <lb n="1r18=18"/>pērkaḷum</item></list>
                    anyōnya cammaticcuk koṇṭu śrītēji
                    <lb n="1r19=19"/>nivantēsvara cuvāmikku artta cāma pūjaikku makamai
                    <lb n="1r20=20"/>kalpiccōm eṅkaḷ payir cilavil kaṇṭu mutalil
                    <lb n="1r21=21"/>ṉūṟṟukkala nellukkuk kuṭivārattilē ṉāṉāḻinel
                    <lb n="1r22=22"/>lu viḻukkāṭu kūlippiccaiyum eṉṟaṉṟaikkum
                    <lb n="1r23=23"/>kuṭuttu naṭappi
                    <pb n="1v"/>
                    <lb n="1v1=24"/>ccu koṇṭu varakkaṭavōmākavum
                </p>
                <p>
                    inta tammam
                    <lb n="1v2=25"/>eṉṟaṉṟaikkum ācantirākkamāka putra pautra
                    <lb n="1v3=26"/>pāramparaiyāka naṭappiccu koḷḷakkaṭavōmākavum.
                </p> 
                
                
                <p>
                    <lb n="1v4=27"/>Inta <hi rend="grantha">dharma</hi>t=tuk=ku yātām oruvaṉ vi<hi rend="grantha">ṁ</hi>pāta<hi rend="grantha">m·</hi> paṇ
                    <lb n="1v5=28" break="no"/>ṇiṉākkil Avaṉ keṅkai karaiyilē kārām
                    <lb n="1v6=29"/> pacuvai k=koṉṟa do<add place="below"><hi rend="grantha">ṣa</hi></add>t=tilē pōka k=kaṭavaṉ ākavum <hi rend="grantha">śiva-
                        <lb n="1v7=30"/>drohi</hi>yāka pōka k=kaṭavaṉākavum <hi rend="grantha">mātr̥-pitr̥-drohi</hi>
                    <lb n="1v8=31" break="no"/>yāka k=kaṭavaṉ ākavum
                </p>
                <p>
                    intap paṭikku acēṣa vitva makā
                    <lb n="1v9=32"/>janaṅkaḷ colpaṭikku 
                   <list><item>caṭṭai ṉātar putraṉ tīṣa
                    <lb n="1v10=33"/>ṉ eḻuttu</item> 
                    <item>viṣṇupuram acēḻa makāceṉaṅkaḷ yeḻuttu
</item>                    
                       <item><lb n="1v11=34"/>ṉālāṅ kaṭṭaḷai acēḻamakāceṉaṅkaḷ ye
                    <lb n="1v12=35"/>ḻuttu</item>
                    <item>villiya ṉallūr acēḻa makāceṉaṅ
                    <lb n="1v13=36"/>kaḷ yeḻuttu
</item>                    <item>pācālai acēḻa makāceṉaṅ
                    <lb n="1v14=37"/>kaḷ yeḻuttu</item>
                    <item><ab>tiruvīḻimiḻalai acēḻa makāca
                    <lb n="1v15=38"/>ṉaṅkaḷ yeḻuttu</ab></item>
                    <item>aṉṉiyūr acēḻa makāce
                    <lb n="1v16=39"/>ṉaṅkaḷ yeḻuttu</item>
                    <item>pācakarai acēḻa makāce
                    <lb n="1v17=40"/>ṉaṅkaḷ yeḻuttu</item>
                    <item>vārappūr makāceṉaṅkaḷ ye
                    <lb n="1v18=41"/>muttu</item>
                    <item>kaṭalaṅkuṭi makāceṉaṅkaḷ
                    <lb n="1v19=42"/>yeḻuttu</item>
                    <item><pb n="2r"/><lb n="2r1=43"/>u pullūr pattu acēḻa makāceṉaṅkaḷ yeḻuttu
                    <lb n="2r2=44"/>kīraṉūr makāceṉaṅkaḷ eḻuttu</item>
                    <item>katirkāmaṅka
                    <lb n="2r3=45"/>lam makāceṉaṅkaḷ eḻuttu</item>
                    <item>talaiyūr makāceṉa
                    <lb n="2r4=46"/>ṅkaḷ eḻuttu</item>
                    <item>kokkaṅkuṭi makāceṉaṅkaḷ eḻu
                    <lb n="2r5=47"/>ttu</item>
                    <item>peṟumpūr makāceṉaṅkaḷ eḻuttu</item>
                    <item>vaṭṭakuṭi makāce
                    <lb n="2r6=48"/>ṉaṅkaḷ eḻuttu</item>
                    <item>kaḷḷikuṭi makāceṉaṅkaḷ eḻuttu
</item>                    <item><lb n="2r7=49"/>kāḷiyārkuṭi makāceṉaṅkaḷ eḻuttu</item>
                    <item>kaṭuvaṅkuṭi maka
                    <lb n="2r8=50"/>raceṉaṅkaḷ eḻuttu</item>
                    <item>vaccarācapuram maka [ ra ] ceṉaṅkaḷ
                    <lb n="2r9=51"/>eḻuttu</item>
                    <item>ampakāttūr makāceṉaṅkaḷ eḻuttu</item>
                    <item>paḻa
                    <lb n="2r10=52"/>ya ampakāttūr eḻuttu</item>
                    <item>tāmaṇaṅkuṭi makācaṉa
                    <lb n="2r11=53"/>ṅkaḷ eḻuttu</item>
                    <item>kaṇṇappūr makāceṉaṅkaḷ
                    <lb n="2r12=54"/>eḻuttu</item>
                    <item>nalleḻuntūr makāceṉaṅkaḷ eḻu
                    <lb n="2r13=55"/>ṅkaḷ eḻuttu</item>
                    <item>kācakkuṭi makāceṉaṅkaḷ eḻuttu</item>
                    <item><lb n="2r14=56"/>puttakuṭi makāceṉaṅkaḷ eḻuttu</item>
                    <item>nallātūr makāceṉaṅ
                    <lb n="2r15=57"/>kaḷ eḻuttu
</item>                    <item>kuṟumpakaram makāceṉaṅkaḷ eḻuttu</item>
                    <item>reṭṭa kuṭi
                    <lb n="2r16=58"/>makāceṉaṅkaḷ eḻuttu</item>
                    <item>cempayaṉ nallūr makāceṉa
                    <lb n="2r17=59"/>ṅkaḷ e [ ḻa ] ttu</item>
                    <item>kuṟuṅkuḷam makāceṉaṅkaḷ eḻuttu</item>
                    <item>pūṅ
                    <lb n="2r18=60"/>kāvūr makāceṉaṅkaḷ eḻuttu.</item>
                   <item> <pb n="2v"/>
                    <lb n="2v1=61"/>tirumākāḷām makāceṉaṅkaḷ eḻuttu</item>
                    <item>yeṉ
                    <lb n="2v2=62"/>kuṭi makāceṉaṅkaḷ eḻuttu</item>
                    <item>puḻukaṉātapuram ma
                    <lb n="2v3=63"/>kāceṉaṅkaḷ eḻuttu</item>
                    <item>vīravayal makāceṉaṅkaḷ
                    <lb n="2v4=64"/>ḷ eḻuttu</item>
                    <item>kūttaṉūr makāceṉaṅkaḷ eḻuttu</item>
                    <item>ti
                    <lb n="2v5=65"/>latapati makāceṉa [ ṅ ] kaḷ eḻuttu</item>
                   <item> curaikāyūr ma
                    <lb n="2v6=66"/>kāceṉaṅkaḷ eḻuttu</item>
                   <item> kāṟkāttai makāceṉaṅ
                    <lb n="2v7=67"/>kaḷ eḻuttu</item>
                    <item>pōḻakuṭi makāceṉaṅkaḷ eḻu
                    <lb n="2v8=68"/>ttu</item>
                    <item>māntai makāceṉaṅkaḷ eḻuttu</item>
                    <item>ṉeṉ
                    <lb n="2v9=69"/>mēli makāceṉaṅkaḷ eḻuttu</item>
                    <item>kōṇappati
                    <lb n="2v10=70"/>makāceṉaṅkaḷ eḻuttu</item>
                    <item>kiḷiyaṉūr ma
                    <lb n="2v11=71"/>kāceṉaṅkaḷ eḻuttu</item>
                    <item>aṇṭakuṭi ma
                    <lb n="2v12=72"/>kāceṉaṅkaḷ eḻuttu</item>
                   <item> ālattūr makāce
                    <lb n="2v13=73"/>ṉaṅkaḷ eḻuttu</item>
                    <item>tirumaṅkala makāceṉaṅka
                    <lb n="2v14=74"/>ḷ eḻuttu</item>
</list>                </p>
                <p>
                    rāja śrī cokkappa mutaliyār avarkaḷ taṟmam
                </p>
                
                
                
                
                
                
                
