        <body>
            
            <div type="edition" xml:lang="tam-Latn" n="1" rendition="class:tamil maturity:83215">		
                
                <pb n="1r"/>
                <ab><g ref="sym:tam-pillaiyarCuli"></g></ab>
                <p>
                    <lb n="1r1=1"/><hi rend="grantha">svasti śrīmaṉ·</hi> makā-maṇṭalēcuraṉ Ariya taḷa-vip
                    <lb n="1r2=2" break="no"/>āṭaṉ pācaikku tappuvarāya kaṇṭaṉ kaṇṭa ṉāṭu
                    <lb n="1r3=3"/>koṇṭu koṇṭa ṉāṭu kuṭātāṉ rācāti-rā
                    <lb n="1r4=4" break="no"/>caṉ rāca-paramēcuvaraṉ rāca-māttāṇṭaṉ rā
                    <lb n="1r5=5" break="no"/>ca uttaṇṭa kōlākalaṉ raṇacutta vīraṉ rā
                    <lb n="1r6=6" break="no"/>ca piratāpaṉ tulukkar taḻa-vipāṭaṉ tulukkar m
                    <lb n="1r7=7" break="no"/>ōkam taviḷttāṉ Oṭṭiya taḷa-vipāṭaṉ oṭṭi
                    <lb n="1r8=8" break="no"/>ya-mōkam taviḷttāṉ Īḷa-maturaik koṇṭu ya
                    <lb n="1r9=9" break="no"/>ā<supplied reason="explanation">ḻ</supplied>ppāṇam ticavēṭṭai yāṭi yaruḷiya vaṅkaḷa
                    <lb n="1r10=10" break="no"/>r ciṅkaḷar maṟāṭar tuḷuvar toṭṭiyar tēcaṅ
                    <lb n="1r11=11"/>kaliṅkam tiṟai koṇṭa karuṇāvatāraṉ ye
                    <lb n="1r12=12" break="no"/>vvirutākilum avvirutukoṇṭōṉ ku <!-- revised until here -->
                    <lb n="1r13=13"/>ṭaikku kaṟṉaṉ aḷakukku maṉmataṉ poṟuai
                    <lb n="1r14=14"/>makku taṟmar kutiraiyēttattukku nakulaṉ
                    <lb n="1r15=15"/>āṟil oru kaṭamai koṇṭa cēra cōḻa pāṇṭiya
                    <lb n="1r16=16"/>ṉ vayatukku mārkaṇṭaṉ rācakōttiram cātakaḷa
                    <lb n="1r17=17"/>rāyar accutarāyar kōpālarāyar āṉantarāyar ki
                    <lb n="1r18=18"/>ṣṇa rāyar rāmarāyar ippaṭi piṟittuvi rācciya
                    <lb n="1r19=19"/>m paṇṇiyaruḷāniṉṟa 
                </p>
                <p>
                    cāliyavākaṉa cakāṟttam
                    <lb n="1r20=20"/><num value="1375"> <g type="numeral">1000</g> 3 <g type="numeral">100</g> 7 <g type="numeral">10</g> 5</num>kku mēl cellā niṉṟa pavanāma camvatca
                    <lb n="1r21=21"/>rattu uttirāyaṇattu vacanta rituvil vaiy
                    <lb n="1r22=22"/>kāci <g ref="sym:tam-varuṣam"></g> 23 <g ref="sym:tam-mācam"></g> pūṟuva paṣacattil cōmavāram tica
                    <lb n="1r23=23"/>miyum pūca naṣcettiramum cupayōka cupakaruṇamum pe
                    <lb n="1r24=24"/>tta cupatiṉattil 
                </p>
                <p>
                    rācarāca vaḻaṉāṭu rācēntira cōḻa
                    <lb n="1r25=25"/>vaḻaṉāṭu cōḻamaṇṭalam kāval koṇṭa ṉāṭu kallūr nel
                    <lb n="1r26=26"/>lūr ceyittu ammaṉam kaṉikoṇṭa ṉāṭu cempoṉ māriyai ce
                    <lb n="1r27=27"/>yaṅkoṇṭa nāṭu ceyaṅkoṇṭār tiruppaṇipurinta vaḻaṉāṭu
                    <lb n="1r28=28"/>miḻalaik kūttattil naṭuvikkūttam pavuttiramāṇikkam catur
                    <lb n="1r29=29"/>vētamaṅkalamāṉa taṉiyūr tirupperuntuṟai cuvāmi ā
                    <lb n="1r30=30"/>ḷuṭaiya paramacuvāmiyārukku uṣcā kālāti pūcaikku rā
                    <lb n="1r31=31"/>caḻī rekuṉāta ṉāyakkaravarkaḷ ṉāḷaiyil vācamākāḷiyā
                    <lb n="1r32=32"/>piḷḷaiyavarkaḷ kiṟaiya cātaṉamāka reṅkalam palakāṟa
                    <lb n="1r33=33"/>rilē vaḻacaṉāta oṭṭaṉ kaṭṭi paḻaiyāṉṉuḷḷiṭṭārum ka
                    <lb n="1r34=34"/>ṭammaṅkaḷāṭu kuruvikkarampai vaṇṭi uḷḷiṭṭārum paṅkāṭ
                    <lb n="1r35=35"/>ṭu ṉāṭu kaḷattūr virutukku mīṇṭa vīraṉuḷḷiṭṭāru
                    <lb n="1r36=36"/>m teṉṉaṅkuṭip piramaṉuḷḷiṭṭārum caṅkamaṅkalam e
                    <lb n="1r37=37"/>pariyāṉuḷḷiṭṭārum ūreṉac camainta vampalakkāṟar ūra
                    <lb n="1r38=38"/>varōm koṭutta paricāvatu 
                </p>
                 <p>   
                    paḻaiya nakaram kālakamarutukku
                    <lb n="1r39=39"/>ellaiyāvatu kuruvikarampai ellai atil 
                     <list><item>kīḷpāṟk
                    <lb n="1r40=40"/>kellai miḷakiṭu pattaikki kollai karampai uḷḷuṟaṇik
                    <lb n="1r41=41"/>kum kōṭṭai kolṉāṭuttiyapaṭi kollaikkum pālaikkāṭṭuva
                    <lb n="1r42=42"/>ṉi etuvāyikku mēṟku</item> 
                     <item>teṉpāṟkkellai viraiyaṭi
                    <lb n="1r43=43"/>kollai vaṭakku</item>
                     <item>mēlpāṟkellai kaḷattūr ellai
                    <lb n="1r44=44"/>nallūrkkum kuṭikāṭṭu veḻuṅkaṭi kollaikkum vaṭa
                    <lb n="1r45=45"/>kāl ūṟaṉi etuvāyi vaṉṉiriyaṭikkum kiḻakku</item>
                     <item>vaṭavāṟ
                    <lb n="1r46=46"/>kellai oṭṭaṉ kāṭṭār kōvil kāṭṭu kollaikku
               <pb n="1v"/>
                    <lb n="1v1=47"/>m kiḻakkiṭu pattaikku teṟkku</item></list>
                     itukku icainta kaṟpiṅ
                    <lb n="1v2=48"/>kaṉāṭu kuruvi karampai ellaiyil inta nānkellaiyum
                    
                     <lb n="1v3=49"/>paṅkāṭṭuṉāṭu kaḷattūr 
                     <list><item>kīḷvāṟkkellai kuṭikkāṭṭu
                    <lb n="1v4=50"/>ṟāṇi vaṉṉiyaṭikkum kuṭikāṭṭu veḻuṅkaṭi kol
                    <lb n="1v5=51"/>laikku kallaṭi tāvai paḷḷattukkum kaḷḷaṉ kāṭṭu
                    <lb n="1v6=52"/>pāmpāṭṭi ōṭai ūraṇikku mēṟoḻuṅkai pāṉāta āti tī
                    <lb n="1v7=53"/>yaṭikkum oṭukkaṇkāṭu vāṉpala kollaikkum mēṟk
                    <lb n="1v8=54"/>ku</item> 
                     <item>teṉvāṟkkellai tirucūlakuṭi vāṉpala utira vēṅ
                    <lb n="1v9=55"/>kaiyaṭi kollaikkuṭi kaṭṭāṉi kollaikkum paḻaiyaṅkāṭi
                    <lb n="1v10=56"/>teṉṉaṅkuṭiyār ellai kallukkum caṅkamaṅkalamatta
                    <lb n="1v11=57"/>tāraṅkaṭivāri kallukkum nāṟamakaṟukuḷattu caṅkamala
                    <lb n="1v12=58"/>ttār kallukkum āvaṉam uḷkaṭai āracalāṉa tarm
                    <lb n="1v13=59"/>mai ellai kallukku vaṭakku</item> 
                     <item>mēlvāṟkkellai a
                    <lb n="1v14=60"/>racalāṉa karampai kīḷpāṟkkellaikku kiḻakku</item> 
                     <item>vaṭava
                    <lb n="1v15=61"/>āṟkkellai nāṟmattu kuḻattukku kaḷattūr kuḻattukku
                    <lb n="1v16=62"/>mēṟkā vāykkāl matura ālaikkum marutaṭi kaḷattūr ūṟaṇi
                    <lb n="1v17=63"/>vayal ellai kallukkum paravoḷi ūṟaṇi ellai paḷḷattu
                    <lb n="1v18=64"/>kkum āttiyaṭi kollai paḷḷattukkum
                    <lb n="1v19=65"/>kaṭṭai ālam kollaikkum paṇṇivīraṉ paḷḷa ke
                    <lb n="1v20=66"/>āllaikkum pūraṇiveḷi taccaṉ oṭṭaṉ kāṭṭa
                    <lb n="1v21=67"/>ār ellai vaṉṉiyam kallukkum teṟkku</item></list>
                     ituk
                    <lb n="1v22=68"/>ku inta kuḷattūr ellaiyum perunāṉkellaiyum 
                     
                    te
                    <lb n="1v23=69"/>ṉṉaṅkuṭi 
                     <list><item>kīḷvāṟkellai kuḷattūraṉ
                    <lb n="1v24=70"/>ellai kallukkum teṉṉaṅkuṭi kuḻam mēlkaṇṭa
                    <lb n="1v25=71"/>kālkaṭṭu taraikkum paṟaiyaṉ ōṭai paḷḷa
                    <lb n="1v26=72"/>ttukkum mēṟkku</item> 
                     <item>teṉvāṟkkellai ōṭai paḷ
                    <lb n="1v27=73"/>ettu etuvāy cōḻakaṉ karampaikku vaṭakku</item>
                    <item><lb n="1v28=74"/>mēlvāṟkkellai kūttaṉ ceykku kaḷat
                    <lb n="1v29=75"/>tūr ellai puṅkaṭi kallukkum kiḻakku</item> 
                     <item>vaṭa
                    <lb n="1v30=76"/>vāṟkellai ōṭai paḷḷattukkum kaḷattu
                    <lb n="1v31=77"/>periya kallukkum teṟkku</item></list> 
                  teṉṉaṅkuṭi
                    <lb n="1v32=78"/>ellai inta peruṉāṅkellaiyum tāṉamñ 
                     
                     ce
                    <lb n="1v33=79"/>ṅkamaṅkalam 
                     <list><item>kaḷattūraṉ yellai puṅkam
                    <lb n="1v34=80"/>vāykkāl kallukkum teṉṉaṅkuṭi yā
                    <lb n="1v35=81"/>ṉa kūttaṉ ceykkum cōḻakaṉ karampaik
                    <lb n="1v36=82"/>ku mēṟkku</item> 
                     <item>teṉvāṟkkellai reṭṭai ūṟa
                    <lb n="1v37=83"/>ṇikku kollaṉ maṭai kiḻakkōṭiya vā
                    <lb n="1v38=84"/>ykkālukkum kaṇṭi kuḻam nīrmaṭikku vaṭa
                    <lb n="1v39=85"/>kku</item> 
                     <item>mēlvāṟkkellai aracalāṉ karampai
                    <lb n="1v40=86"/>kīḷvāṟkkellai kallukkum kiḻakku</item> 
                     <item>vaṭa
                    <lb n="1v41=87"/>vāṟkkellai nāṟmattu kuḻattu uḷḷūṟa
                    <lb n="1v42=88"/>ṉimaṟkarai kallum naṭumaṇṭavar vāykkāl pu
                    <lb n="1v43=89"/>ṅkaṭi kallukkum teṟkku</item></list> 
                     inta caṅma
                    <lb n="1v44=90"/>ṅkalam ellaiyil icainta perunāṅke
                    <lb n="1v45=91"/>kallaiyum 
                     
                     vaḻutalai ṉāṭu oṭṭaṉkāṭu kīḷpā
                    <lb n="1v46=92"/>ṟ kellai miḻakiṭu pattai kollaikkum
                </p>
                
