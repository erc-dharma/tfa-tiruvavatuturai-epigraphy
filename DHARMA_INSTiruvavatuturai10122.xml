        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <p>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </p>
                <p>
                    matirai koṇṭa
                    <lb n="2" break="no"/>kō-p-para-kēcari-paṉmaṟki yā
                    <lb n="3" break="no"/>ṇṭu <num value="38">3 <g type="numeral">10</g> 8</num> Āvatu teṉkarai-t
                    <lb n="4"/>tiruvaḻuntūr-nāṭṭu <hi rend="grantha">brahmade</hi>
                    <lb n="5" break="no"/>yam ciṟṟāṉaiccūr <hi rend="grantha">sabhai</hi>yō
                    <lb n="6" break="no"/>m <hi rend="grantha">śrī</hi>-tiru-v<unclear>ā</unclear>vaṭutuṟai tiru-k-
                    <lb n="7" break="no"/>-kaṟṟaḷi-p piccar iṭai poṉ koṇ
                    <lb n="8" break="no"/>ṭu tiru-vāvaṭutuṟai <hi rend="grantha">de</hi>varkku
                    <lb n="9"/>viṟṟu-k kuṭutta nilatukk’ el
                    <lb n="10" break="no"/>lai
                    
                    <list>
                        <item>k<choice><orig>i</orig><reg>ī</reg></choice>ḻ-pārk’ ellai <hi rend="grantha">śrī</hi>-tiru-vāva
                            <lb n="11" break="no"/>ṭutuṟai <hi rend="grantha">de</hi>var nilattukku mē
                            <lb n="12" break="no"/>ṟkum</item>
                            <item>teṉ-pārk’ ellai kumāraṭi
                            <lb n="13"/>nampiyār kāvil toṭṭikkum ki
                            <lb n="14" break="no"/>ṇaṟṟukkum pānta-peruvaḻikku
                            <lb n="15"/>vaṭakkum</item>
                            <item>mēl-pārk’ ellai cā
                            <lb n="16" break="no"/>ttāṉūr <hi rend="grantha">sabhai</hi>yār nilamē A
                            <lb n="17" break="no"/>ṭaiya Araikkāl nilam cuṭu-kā
                            <lb n="18" break="no"/>ṭu viṭṭu kiḻakkum</item>
                            <item>vaṭa-pārk’ el
                            <lb n="19" break="no"/>lai Āṟi-p paṭukai Uṭpaṭṭa kāvirikku
                            <lb n="20"/>teṟkum</item>
                    </list>                    
                </p>
                
                <p>
                    Ivv-icaitta nāṉ<surplus>k</surplus>
                    <lb n="21" break="no"/>k’ ellaiyilum Akappaṭṭa nilam
                    <lb n="22" break="no"/>Uṭump’ ōṭi Āmai tavaḻnta
                    <lb n="23" break="no"/>t’ ellām Uṇṇilam Oḻiv’ iṉ
                    <lb n="24" break="no"/>ṟi poṉ koṇṭu viṟṟu-k kuṭut
                    <lb n="25" break="no"/>tōm I<choice><orig>ṉ-ṉ</orig><reg>n-n</reg></choice>ilam Eppērpaṭṭa
                    <lb n="26"/>Iṟaiyum Eccōṟum veṭṭi-vē                  
                </p>
                
            </div>
            
