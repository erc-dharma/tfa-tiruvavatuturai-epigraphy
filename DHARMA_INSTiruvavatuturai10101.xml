                        </item>
                        <item>
                            Ip-paṭi Arivē<choice><orig>n</orig><reg>ṉ</reg></choice> pāṇtikulācani-vaḷanāṭṭu c<choice><orig>i</orig><reg>ī</reg></choice>-kaṇṭa-c-catu<hi rend="grantha"><supplied reason="omitted">r</supplied>vvedi</hi>-maṅkalattu kāvaṉūr Iḷaiy<unclear>a-n</unclear>ārāya<unclear>ṇa</unclear>-<hi rend="grantha">kra</hi>mavitta<choice><orig>n</orig><reg>ṉ</reg></choice>-ē<choice><orig>n</orig><reg>ṉ</reg></choice>
                        </item>
                        <item>
                            Ip-paṭi Arivēṉ<choice><orig>n</orig><reg>ṉ</reg></choice> curavi Ā<hi rend="grantha">di</hi>t=ta-<hi rend="grantha">kra</hi>ma-vit=ta<choice><orig>n</orig><reg>ṉ</reg></choice>-ē<choice><orig>n</orig><reg>ṉ</reg></choice>
                        </item>
                        <item>Ip-paṭi Aṟivēṉ Ivv-ūr ciyapurattu nākiyaṇṇa-<hi rend="grantha">kra</hi>mavit=ta<choice><orig>n</orig><reg>ṉ</reg></choice>-ē<choice><orig>n</orig><reg>ṉ</reg></choice>
                        </item>
                        <item>
                            Ip-pa<lb n="8" break="no"/>ṭi Aṟivē<choice><orig>n</orig><reg>ṉ</reg></choice> Arumoḻi-tēva-vaḷanāṭṭu-p puṟampaināṭṭu-t tinakkaḷar-k-karaṇattā<choice><orig>n</orig><reg>ṉ</reg></choice> vārakk<unclear>i</unclear>ya<choice><orig>n</orig><reg>ṉ</reg></choice> Ī<hi rend="grantha">śvara</hi>-nak<unclear cert="low">ka</unclear>-tāṭi-y-ē<choice><orig>n</orig><reg>ṉ</reg></choice> <g ref="sym:flourish-taperOut" type="punctuation">.</g>
