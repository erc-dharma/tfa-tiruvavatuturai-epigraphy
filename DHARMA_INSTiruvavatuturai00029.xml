            <div type="edition" xml:lang="tam-Latn" n="1" rendition="class:tamil maturity:83215">		
                
                
                <pb n="1r"/>
                <p>
                    <lb n="1r1=1"/><hi rend="grantha">svasti śrīman</hi>‌ makāmaṇṭalē<hi rend="grantha">sva</hi>rān‌ ariya<hi rend="grantha">rā</hi>ya taḷavi-
                    <lb n="1r2=2"/><hi rend="grantha">pāṭan‌ pāṣai</hi>kkut‌ tappuvarāyira kaṇṭaṉ‌ mūvarāyar‌
                    <lb n="1r3=3"/>kaṇṭaṉ‌ kaṇṭanāṭu koṇṭu koṇṭanāṭu kuṭātā
                    <lb n="1r4=4" break="no"/>ṉ‌ <hi rend="grantha">pūrva dakṣi</hi>ṉa <hi rend="grantha">paścima</hi> u<hi rend="grantha">ttarasapta samudrātipa</hi>ti em
                    <lb n="1r5=5" break="no"/>maṇṭalamuṅ‌ <unclear rend="check">koṇṭūḻantiṟa</unclear> koṇṭaruḷiya rā
                    <lb n="1r6=6" break="no"/><hi rend="grantha">jādhirājan rājaparameśvaran‌ rāja mā<supplied reason="omitted">r</supplied>ttā</hi>ṇḍan‌ rā
                    <lb n="1r7=7" break="no"/><hi rend="grantha">ja <choice><orig>ke</orig><reg>ga</reg></choice>ṃbhīran‌ rājā</hi>kkaḷ‌ tam‌pirāṉ‌<hi rend="grantha"> sakalaguṇa saṃ
                    <lb n="1r8=8" break="no"/>pannan‌ saptabhāsarāyan‌ sa</hi>kalakalā <hi rend="grantha">pra</hi>vīṇaṉ‌ <hi rend="grantha">sa</hi>ṅkīta
                    <lb n="1r9=9"/><hi rend="grantha">sā</hi>yu<hi rend="grantha">jya</hi> vi<hi rend="grantha">dyā</hi> viṉōtaṉ‌ keṭikōṭṭumallaṉ‌ keṭikō
                    <lb n="1r10=10" break="no"/>ṭṭu rāyan tu<surplus>tu</surplus>lukkar‌ taḷavipāṭaṉ‌ tulukkar‌ mōkan tavi<choice><sic>ḻ</sic><corr>r</corr></choice>-
                    <lb n="1r11=11" break="no"/>ttāṉ‌ vaṭavaracar‌ maṇavāḷar‌ Iḷaivaracar‌ kulaikāṟaṉ‌ <hi rend="grantha">rāj</hi>
                    <lb n="1r12=12" break="no"/>ātirācaṉ‌ <hi rend="grantha">rāja-parameśvaran</hi> mētiṉiy<hi rend="grantha">īśvara</hi> kaṇṭan‌
                    <lb n="1r13=13"/>kaṭṭāri cāḷuvaṉ‌ Oṭṭiyar‌ taḷavipāṭaṉ‌ Oṭṭiyar‌ mō
                    <lb n="1r14=14" break="no"/>kan‌ taviḻttāṉ‌ vīra<hi rend="grantha">pratāpan</hi>‌<hi rend="grantha"> atala-vitala-sutala
                    <lb n="1r15=15"/>nitala-rasātala-mahātala-pātāḷa</hi>-v-ēḻu-lōka-<hi rend="grantha">pra</hi>ka
                    <lb n="1r16=16" break="no"/>ṇṭaṉ‌ pāṇṭimaṇṭala pa<hi rend="grantha">dmāsa</hi>ṉattōṉ‌ cōḻamaṇ‌
                    <lb n="1r17=17" break="no"/>ṭala-<hi rend="grantha">stāpanācāryan‌</hi> toṇṭamaṇṭala-<hi rend="grantha">pratiṣṭāpa</hi>ṉāc
                    <lb n="1r18=18" break="no"/>āriyaṉ‌ mat=ta<choice><orig>ge</orig><reg>ga</reg></choice>ja-pariśuddha-nakulaṉ‌ <hi rend="grantha">giridurga</hi> vaṉatu<hi rend="grantha">rga</hi>
                    <lb n="1r19=19"/><hi rend="grantha">jaladurga pararā</hi>ca<hi rend="grantha">kēsari Aśvapati</hi> kecapati taṉapati
                    <lb n="1r20=20"/><hi rend="grantha">narapati</hi>-y-āṉa kumāra mallikāṟcuṉarāyar‌ virūpā
                    <lb n="1r21=21" break="no"/><hi rend="grantha">kṣi</hi> rāyar‌ kumāra makārāyar‌ Ati<hi rend="grantha">ba</hi>larāyar‌ śrī vi
                    <lb n="1r22=22" break="no"/><hi rend="grantha">ṣṇu rā</hi>yar‌ <hi rend="grantha">devarāyar‌</hi> Accuta<hi rend="grantha">deva mahārā</hi>yar ta<hi rend="grantha">rmma
                    <lb n="1r23=23"/>rā</hi>yar‌ <hi rend="grantha">sadāśiva</hi>rāyar‌ <hi rend="grantha">kṛṣṇadēvamahārāyar‌ rāmade</hi>
                    <lb n="1r24=24" break="no"/>va <hi rend="grantha">mahārā</hi>yar <hi rend="grantha">pṛthivi rājyam‌ pa</hi>ṇṇi aruḷā niṉṟa                
                </p>
                <p>
                    <lb n="1r25=25"/>sakābdam‌ 1 5 0 5 itaṉ mēlc‌ cellā niṉṟa pra
                    <lb n="1r26=26"/>mōdūta [varuṣam] taiy ‌[mācam] 17 [tēti] kuruvāramum ‌aṉuṣa na-
                    <lb n="1r27=27"/>kṣatramum‌ pañcamiyum‌ śubhanāma yōkamum‌ peṟṟa
                    <lb n="1r28=28"/>śubhadiṉattilē rāyar‌ kāriyattukku kaṟttarāṉa ac‌-
                    <lb n="1r29=29"/>cutappa nāyakkar ‌Ayyaṉ avarkaḷ‌ Ātoṇṭaimā
                    <lb n="1r30=30"/>ṉār‌ Aṅkiṣattil‌ rekuṉātat‌ toṇṭaimāṉār avarka-
                    <lb n="1r31=31"/>ḷ ‌rājyam‌ paṇṇi varukuṟa ṉāḷaiyil
                    ‌</p>
                
                <p>
                    apaṉ‌pa{tt}āṟu 
                    <lb n="1r32=32"/>tēcat=til‌ Iru{kka}ppaṭṭa pāvamillāta kulat=tār‌, mā-
                    <lb n="1r33=33"/>yaṉai vaḷat=tavar‌, Āya kulattōr, yacati kavi ko-
                    <pb n="1v"/>
                    <lb n="1v1=34"/>ṇṭavar‌, Āṟ[>āyar]pāṭit‌ talaivar‌, poṅkiya maturaiyilc‌ caṅ-‌
                    <lb n="1v2=35"/>kattai veṉṟavar‌, mullaikkatipar‌, mullaiyantār‌ mā-
                    <lb n="1v3=36"/>rpar‌, keruṭak keruṭak‌ koṭiy ātipar‌, Avvai pāṭal‌
                    <lb n="1v4=37"/>kōṇṭōr‌, tuṟkai pātacēkarar‌, murukaṉukku kulavaiya-
                    <lb n="1v5=38"/>ḷittavar‌, Aracar‌ mūvaruk‌k’ aṉṉaṅ‌ koṭuttavar‌, cōḻaṉu-
                    <lb n="1v6=39"/>kku muṭi cūṭṭiṉavar‌, takkaṉukkut‌ tiṟaviṭai koṭuttavar‌,
                    <lb n="1v7=40"/>kōkulam‌ kāvalar ākiya Aṉpat=tāṟu rājyattil‌ Irukku
                    <lb n="1v8=41"/>ṟa nanta kōpālar‌ Aṉaivarum‌ pōviṇṭamārum‌
                </p>
                <p>
                    catur‌ vedamaṅ-‌
                    <lb n="1v9=42"/>kalam‌ civapuramāṉa tirupperuntuṟaiyil irukkum‌ nayiṉār aṭiyāril‌
                    <lb n="1v10=43"/>ēkāmpara‌ piṟaicūṭum‌ paṇṭārattukku taṟmma cātaṉa paṭṭai-
                    <lb n="1v11=44"/>yam‌ kuṭutta paricāvatu
                </p>
                <p>
                    cakala Uṟaviṉmuṟaiyār‌ puṇṇiyamā
                    <lb n="1v12=45"/>ka ceḻumalaṟ‌ kuruntil ‌eḻuntaruḷi Iruk=kappaṭā [ni]ṉṟa Āvuṭaiya para-
                    <lb n="1v13=46"/>ma svāmiyārk=ku Apiṣēkam‌, neyvēt=tiyam, tirumālai, tiruviḷak=ku, tiruk=ka-
                    <lb n="1v14=47"/>[ṭa>ṭṭa]ḷai, tirumaṇṭapam‌, tiruṉa[nta]vaṉa tirumaṭamum kaṭṭaḷaiyiṭṭa paṭiyiṉāle
                    <lb n="1v15=48"/>naṭa[k]kum cu[va>vā]t=tiyat=tukku kuṭikku Oru paṇamum, eḻut=tāṇik=ku Oru pa-
                    <lb n="1v16=49"/>ṇamum‌, kav[u>a?]ṟu kalacam‌ piṭittavaṉ‌ Araippaṇamum‌, periya
                    <lb n="1v17=50"/>vācal‌ pallak=kukku ca[ṉu>ṉa]t=tuk=ku oru paṇamum‌, cillaṟaivācal‌
                    <lb n="1v18=51"/>añcu paṇamum‌, pāḷaiyakkāṟar‌ vācal‌ pat=tu paṇamum‌, tirukkaliyā-
                    <lb n="1v19=52"/>ṇat=tuk=ku māppiḷḷai Oru paṇamum‌, peṇvīṭu Oru paṇamum‌, cō-
                    <lb n="1v20=53"/>paṇat=tuk=ku oru paṇamum‌, cīmantak‌ kaliyāṇat=tuk‌k’ oru paṇamum‌, I-
                    <lb n="1v21=54"/>ntappaṭikku cakalarum‌ kuṭukkak‌ kaṭavarākavum‌</p>
           
                
                <p>
                    Inta-p paṭikku ti
                    <lb n="1v22=55" break="no"/>rumālai <surplus>tirumālai</surplus> tiruviḷakku tiruṉantavaṉam tirumaṇ
                    <lb n="1v23=56" break="no"/>ṭapam tirumaṭamum cantirātit=ta-varaikkum puttiṟa-pavuttuṟa-pā
                    <lb n="1v24=57" break="no"/>ramparaiyum naṭappiccu-k koḷḷa-k kaṭavar ākavu=M
                </p>
                
                <p>Inta taṟm
                    <lb n="1v25=58" break="no"/>mattai yātām oruvar paripālaṉam paṇṇi<choice><sic>a</sic><corr>i</corr></choice>ṉa pērkaḷ
                    <lb n="1v26=59"/>Aṟupattu mūvarum māṇikkavācakarum caṇṭēcura-p piḷ
                    <lb n="1v27=60" break="no"/>ḷaiyārum paṉṉit=tira Āḻvārum peṟṟa pēṟu peṟa-k=- kaṭavar
                    <lb n="1v28=61"/>ākavum Inta taṟmat=tukku vikātam paṇṇiṉa pērkaḷ kāci
                    <lb n="1v29=62"/>keṅkai pirayākai tiruvēṇi caṅkamat=til cētu taṉu<hi rend="grantha">ṣ</hi>k
                    <lb n="1v30=63"/>kōṭiyil kār-ām-pacuvaiyum pir=āmaṇaraiyam mātā-pit 
                    <lb n="1v31=64" break="no"/>āvaiyum kurukkaḷaiyu=M koṉṟa tō<hi rend="grantha">ṣ</hi>at=tilē pōka kaṭa
                    <lb n="1v32=65" break="no"/>vōr ākavum
                </p>
                
                <p>Inta paṭik=ku nantakōpālā=rum pōviṇ
                    <lb n="1v33=66" break="no"/>ṭamār aṉaivaruñ colla Inta taṟmma-cātaṉa-p-paṭṭaiyam 
                    <lb n="1v34=67"/>Eḻutiṉēṉ tiru-p-peruntuṟai māṇikka-kūt=ta-mutali
                    <lb n="1v35=68"/>yār Eḻut=tu <g ref="sym:tam-pillaiyarCuli" type="punctuation">.</g>
                </p>
                <ab>
                    <hi rend="grantha">śubham astu</hi>
                </ab>
                <p><add place="unspecified">Inta paṭṭaiya-p paṭikku ye
                    <lb n="1v36=69" break="no"/>ṅkaḷ-c cāti put=tirāṉa kaṇṭiya t=tirukkōṭi tēvaram paṇa
                    <lb n="1v37=70" break="no"/>m kuṭāta pēraiyum taṟmmattilē yītaipātai 
                    <lb n="1v38=71"/> varāmal naṭappikkavum <g ref="sym:tam-pillaiyarCuli" type="punctuation">.</g></add>
                </p>
                
