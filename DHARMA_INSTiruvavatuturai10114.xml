        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <p>
                    <lb n="1"/>tirukkaḷ kāciyava<choice><orig>n</orig><reg>ṉ</reg></choice> Appi
                    <lb n="2"/>veṅkaṭa<choice><orig>n</orig><reg>ṉ</reg></choice>ukku cōtaṇa
                    <lb n="3" break="no"/>-kāṇi Āka v-iṭṭa nila<supplied reason="omitted">m</supplied> Āvatu 
                </p>
                
                <p>
                    I
                    <lb n="4" break="no"/>n-nāṭṭu neṟkuppai mu
                    <lb n="5" break="no"/>-vēliyi<choice><orig>n</orig><reg>ṉ</reg></choice> kiḻai-p-patti
                    <lb n="6" break="no"/>l meṟk’ aṭaiya Eḻu mā
                    <lb n="7" break="no"/>vum cantirāti<choice><sic>cc</sic><corr>tt</corr></choice>aval
                    <lb n="8"/>cōtaṇa-kāṇi Āka c<choice><orig>e</orig><reg>ey</reg></choice>tu
                    <lb n="9"/>kuṭuttōm Aruḷāḷ kuṭu
                    <lb n="10" break="no"/>ttōm <hi rend="grantha">de</hi>va-ka<hi rend="grantha">nmi</hi>kaḷōm
                    
                </p>
                
            </div>
            
            <!--<div type="apparatus">			
