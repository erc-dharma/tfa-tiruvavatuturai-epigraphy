        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <p>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </p>
                <p>
                    matirai koṇṭa kō-p-para
                    <lb n="2" break="no"/>-kēcari-pa<hi rend="grantha">nma</hi>k=ku yāṇṭu <num value="36">3 <g type="numeral">10</g> 6</num> Āva<supplied reason="omitted">tu</supplied>
                </p>
                <p>                    
                    <lb n="3"/>teṉ-karai tiraim<choice><orig>u</orig><reg>ū</reg></choice>r-nāṭṭu <hi rend="grantha">brahma</hi>
                    <lb n="4" break="no"/>tē<unclear>yam</unclear> cāttaṉūr <hi rend="grantha">śrī</hi>-tiruvāva
                    <lb n="5" break="no"/>ṭutuṟai Āḷvārkku nampaṉ
                    <lb n="6"/>v<choice><orig>i</orig><reg>ī</reg></choice>re<hi rend="grantha">śva</hi>raṉ Oru non=tā viḷak
                    <lb n="7" break="no"/>kiṉukku ca<hi rend="grantha">n<choice><orig>t</orig><reg>d</reg></choice>r<surplus>i</surplus>ā</hi>tittavaṟ niṟa
                    <lb n="8" break="no"/>pataṟkku vaicca Āṭu to<unclear cert="low">n=nū <g type="numeral">10</g></unclear>
                </p>
                <p>
                    <lb n="9"/>Ivai <hi rend="grantha">panmāheśva</hi>
                    <lb n="10" break="no"/><hi rend="grantha">ra-rakṣai</hi>
                </p>
                
            </div>
            
            <div type="apparatus">			
                <listApp>
                    <app loc="7">
                        <lem>niṟa<lb n="8" break="no"/>pataṟkku</lem>
                        <note><foreign>Erippataṟku</foreign> is expected here instead.</note>
                    </app>
                    <app loc="8">
                        <lem>to<unclear cert="low">n=nū <g type="numeral">10</g></unclear></lem>
                        <note>This stands, in any case, for <foreign>toṇṇūṟu</foreign>.</note>
                    </app>
                </listApp>
            </div>
            
