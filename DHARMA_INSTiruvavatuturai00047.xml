        <body>
            
            <div type="edition" xml:lang="tam-Latn" n="1" rendition="class:tamil maturity:83215">		
                
                <pb n="1r"/>
                <p>
                    <lb n="1r1=1"/><g ref="sym:tam-pillaiyarCuli" type="ideogram">@</g> Āṟumukaneripaṭṭaiyam 
                </p>
                <p>
                    cuvatti* cālivāka
                    <lb n="1r2=2" break="no"/>ṉa cakāt=tam <num value="1619">1 <g type="numeral">1000</g> 6 <g type="numeral">100</g> <g type="numeral">10</g> 9</num> <g ref="sym:tam-kku">kku</g> <g ref="sym:tam-varuṣam"></g> cellā niṉra 
                    <lb n="1r3=3"/>kollam <num value="872">8 <g type="numeral">100</g> 7 <g type="numeral">10</g> 2</num> <g ref="sym:tam-varuṣam"></g> yīcupā <g ref="sym:tam-varuṣam"></g> vaiyakāci <g ref="sym:tam-mātam"></g>
                    <lb n="1r4=4"/> <num value="14"> <g type="numeral">10</g> 4</num> <g ref="sym:tam-tēti"></g><g ref="sym:tam-varuṣam"/> titi pūṟuva-paṭcat=til t=tiri-tikaiyu=M cikkiṟa-vāra 
                    <lb n="1r5=5" break="no"/>mum cupa-yōkamum cupa-karaṇamum peṟ=ṟa miṟika-cīraṣa
                    <lb n="1r6=6" break="no"/>naṭccet=tirat=til nāl-c ceyta taṉma-cātaṉa-p-paṭ
                    <lb n="1r7=7" break="no"/>ṭaiya=Mmāvatu
                </p>
                <p>
                    kuṭaṉāṭāṉ tiruccentūr centi
                    <lb n="1r8=8"/>māṉakarattilirunkkum cuppira<expan><abbr>mī</abbr><ex>māṉya</ex></expan>ya<expan><abbr>c=vi</abbr><ex>cuvāmi</ex></expan> kōvi=L t=tala
                    <lb n="1r9=9" break="no"/>t=tāril nārayaṇa pi=Lḷai Uṭaiyār pi=Lḷaiyeṉ kīḷ vem
                    <lb n="1r10=10" break="no"/><surplus>punāṭā</surplus>pu-nāṭāṉ tirunelveli yiruk=kum yiLaiya pe
                    <lb n="1r11=11" break="no"/>rumāḷ pi=Lḷai cuntara-t-toḷ-pi=Lḷai<g ref="sym:tam-kku">kku</g> taṉma-cātaṉa-p-paṭṭai
                    <lb n="1r12=12" break="no"/>ya=M yeḷuti-k kuṭu<choice><orig>ṟ=ṟa</orig><reg>tta</reg></choice> paricāvatu <unclear reason="eccentric_ductus">ku</unclear>ruk=kaḷukku-p puṇṇiyamāka
                    <lb n="1r13=13" break="no"/>vum <expan><abbr>r=a<g ref="sym:bar"></g></abbr><ex>rāja</ex></expan> taḷavāy naracappayyaṉ avarkaḷuk=ku-p puṇṇiyam
                    <lb n="1r14=14" break="no"/>ākavu=M vaṭamalaiyappa-p-pi=Lḷaiyeṉ <unclear rend="check"><g type="symbol">X</g></unclear><!-- here Krishnamurti reads "makaṉ" but I dont see on which basis, and in general he has misread this inscription quite a bit-->k=ku-p puṇṇiyamāka
                    <lb n="1r15=15" break="no"/>vu=M muṟuṉāyakam pi=Lḷaik=kupuṇṇiyamākavum tirucce
                    <lb n="1r16=16" break="no"/>ntūr <expan><abbr>c=vi</abbr><ex>cuvāmi</ex></expan> kōvi-L pōt=timā=r tāṉattā=r talattā=r muta
                    <lb n="1r18=18" break="no"/>lāṉa perukaḷuk=ku p-puṇṇiyamākavu=M <expan><abbr>c=vi</abbr><ex>cuvāmi</ex></expan> cuppira<expan><abbr>mī</abbr><ex>māṉya</ex></expan>ya
                    <lb n="1r19=19"/><expan><abbr>c=vi</abbr><ex>cuvāmi</ex></expan> kōvi=L-k-kaṭ=ṭaḷai naṭakkum pa=ṭik=ku yivarkaḷuk=ku nāṉ
                    <lb n="1r20=20"/>viṭṭu k-kuṭu<choice><orig>ṟ=ṟa</orig><reg>tta</reg></choice> nilam āvatu 
                </p>     
                <p>
                    eṉ nilamaiyāṉa Āṟumukane
                    <lb n="1r21=21" break="no"/>riyai viṭṭukkuṭut=ta paṭiyiṉālē yitaṟk=ku kiṟaiya=M niṣ
                    <lb n="1r22=22" break="no"/>cciyat=tukku <g ref="sym:tam-poṉ"></g> <num value="105"> <g type="numeral">100</g> 5</num> Ūcikkāntam <g ref="sym:tam-paṇam"></g> Āka nū<choice><orig>t=ti</orig><reg>ṟṟi</reg></choice>
                    <lb n="1r23=23"/>Añcu poṉṉum Oru paṇam yin=ta poṉ <g ref="sym:tam-poṉ"></g> <num value="105"> <g type="numeral">100</g> 5</num>
                    <lb n="1r24=24"/> <g ref="sym:tam-paṇam"></g> <unclear rend="check">O</unclear>ṉ=ṟuk=ku nāṉ viṭṭu-k kuṭutta Ārumukanerikku E
                    <lb n="1r25=25" break="no"/>lkakaiyāvatu
                </p>
                <p>
                    coṇaka-paṭ=ṭaṇattār Elkai pa=ṭi
                    <lb n="1r26=26"/>teṉvaṭal Oṭiya pātaiku mēkku teṉ Elkai
                    <lb n="1r27=27"/>māyakkūt=tar tiruviḷaiyāṭ=ṭam maṉakkaṭu cīṉan
                    <lb n="1r28=28"/>toppu Elkaikkum vaḷḷivākkāluk=kum kiḷak=ku
                    <lb n="1r29=29"/>vaṭa Elkai yāvatu coṇakapaṭ=ṭaṉat=tār Elkai
                    <lb n="1r30=30"/>kīḷmelloṭiya pātaikku tek=ku Āka yiṉṉāṉȧṅ
                    <lb n="1r31=31" break="no"/>ku Elkaikkuḷ p-paṭ=ṭa nañcey puñcey palapaṭ=ṭa
                    <lb n="1r32=32" break="no"/>ṭai coṉṉā<unclear rend="check">kū</unclear><!-- what I transcribed as "kū" is a symbol that mostly likely related to some trasnformation of tā; Kirshnamurti as tāya-->mum mēl nōkkiyamāmum kī
                    <lb n="1r33=33" break="no"/>ḷ nōkkiya kiṇaṟum niti-nicciya-mutalāṉatu    
                    <lb n="1r34=34" break="no"/>kk' ellām 
                    yivarkaḷē yōkkiyamāka Āccant
                    <lb n="1r35=35" break="no"/>rākkam cantira-p-pirṟavēcam Aṉupavi<choice><orig>ṟ=ṟu</orig><reg>ttu</reg></choice> k-koṇ
                    <lb n="1r36=36" break="no"/>ṭu cuvāmikku k-kaṭ=ṭaḷai naṭat=tiviccu-k koḷvarā
                    <lb n="1r37=37" break="no"/>kavu=M 
                </p>
                <p>
                    yin=ta taṟnattai yātām Oruvar paripālaṉa=M
                    <lb n="1r38=38"/>paṇṇiṉa perkaḷ Acupameta-yākam paṇṇiṉa
                    <lb n="1r39=39"/>palattai p=peṟuvarākavu=M yin=ta taṟma<choice><orig>ṟ=ṟu</orig><reg>t=tu</reg></choice>kku Akut=ta
                    <lb n="1r40=40" break="no"/>m paṇṇiṉa perkaḷ keṅkai-k-karaiyi=L kāram pa
                    <lb n="1r41=41" break="no"/>cuvai k=koṉṟa tocattil p-pōvarākavu=M yi
                    <lb n="1r42=42"/>ppa=ṭikku c-cammati<choice><orig>ṟ=ṟu</orig><reg>ttu</reg></choice> yin=ta taṟma-cātaṉa-p-paṭṭai
                    <lb n="1r43=43"/>yam yeḷuti k=kuṭuttōm
                </p>
                <p>
                    talat=tāril narāyaṇapiL
                    <lb n="1r44=44" break="no"/>ḷai Uṭaiyar pi-Lḷaiyēṉ yiḶaiya perumāḷ piLḷai
                    <lb n="1r45=45"/>cuntara-t-toḷ piLḷaik=ku yipa=ṭik=ku narāyaṇa piLḷai
                    <lb n="1r46=46"/>Uṭaiyar pi=Lḷai yipa=ṭik=ku yivarkaḷ colla yin=ta
                    <lb n="1r47=47"/>taṟma-cātaṉa-paṭṭaiyam Eḷutiṉē nāṭṭukaṇa<g ref="sym:tam-kku">kku</g>
                    <lb n="1r48=48"/>Iraṅkunāta pu=Lḷai marumakaṉ kaḷḷappirāṉ Eḷu
                    <lb n="1r49=49"/><choice><orig>ṟ=ṟu</orig><reg>ttu</reg></choice> yippa=ṭi Aṟivēṉ nayiṉāpi=Lḷai <g ref="sym:tam-piḷḷaiyarcuḻi" type="punctuation"></g>
                </p>
                
      
            
                
                
